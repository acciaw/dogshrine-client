{
  "name": "dogshrine",
  "productName": "Dog Shrine",
  "version": "0.1.0",
  "description": "Unified launcher for Undertale, Undertale Yellow, and Deltarune",
  "main": "src/main/main.js",
  "author": "Acciaw <contact@accw.dev>",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
